# Aponta o escopo @nexus-creator-app para o GitHub Packages registry
@nexus-creator-app:registry=https://npm.pkg.github.com

# Token de autenticação — preenchido pelo CI via secret, ou localmente via ~/.npmrc
# NÃO commite um token real aqui
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Necessário porque @storybook/addon-a11y v10 tem peer deps que conflitam
# com a versão de React e @testing-library usada internamente pelo Storybook
legacy-peer-deps=true
